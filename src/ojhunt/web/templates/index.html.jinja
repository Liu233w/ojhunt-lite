{% extends "base.html.jinja" %}

{% block extra_head %}
<link rel="stylesheet" href="/assets/index.css?v={{ static_version }}">
{% endblock %}

{% block title %}OJHunt Lite{% endblock %}

{% block page_id %}page-home{% endblock %}

{% block content %}
<header class="header">
    <div class="mark">
        <img src="/assets/logo.png" alt="OJHunt Logo">
        <div>
            <h1>OJHunt Lite</h1>
            <div class="h-meta"><span class="cjk">西北工业大学 ACM 协会</span></div>
        </div>
    </div>
    <div class="subtitle">
        <span class="prompt">$</span> pip install ojhunt<br>
        <span class="prompt">$</span> ojhunt username<span style="color:var(--acc)">@</span>crawler
    </div>
</header>

<div x-data="ojhunt()" x-init="init()">

    <!-- ═══ STEP 1 — LOAD REPORT ═══ -->
    <div class="step">
        <span class="n">01</span>
        <h2>Load your report</h2>
        <span class="hint">(optional — your PDF carries your crawler list and history)</span>
    </div>

    <!-- Report slot: loaded state -->
    <div class="report-slot loaded" x-show="cachedPdfDate" x-cloak
         :class="{ 'drag-over': isDragging }"
         @dragover.prevent="isDragging = true"
         @dragleave="isDragging = false"
         @drop.prevent="isDragging = false; $event.dataTransfer.files[0] && uploadReport($event.dataTransfer.files[0])">
        <div class="icon">PDF</div>
        <div class="rs-body">
            <div class="title" x-text="cachedPdfFilename || 'report.pdf'"></div>
            <div class="meta">
                <span><span class="k" x-text="queries.length"></span> crawlers</span>
                <span class="sep">·</span>
                <span>last queried <span class="k date" x-text="cachedPdfDate"></span></span>
            </div>
        </div>
        <div class="rs-actions">
            <label>
                <input type="file" accept=".pdf" x-ref="pdfUploadInput"
                       @change="uploadReport($event.target.files[0]); $event.target.value=''"
                       style="display:none">
                <button type="button" class="btn sm ghost" @click="$refs.pdfUploadInput.click()">replace</button>
            </label>
            <button type="button" class="iconbtn danger" title="remove pdf" @click="clearCachedPdf()">×</button>
        </div>
    </div>

    <!-- Report slot: empty state -->
    <div class="report-slot" x-show="!cachedPdfDate" x-cloak
         :class="{ 'drag-over': isDragging }"
         @dragover.prevent="isDragging = true"
         @dragleave="isDragging = false"
         @drop.prevent="isDragging = false; $event.dataTransfer.files[0] && uploadReport($event.dataTransfer.files[0])">
        <div class="icon">PDF</div>
        <div class="rs-body">
            <div class="title">No report loaded</div>
            <div class="meta" style="color:var(--fg-4)">
                Drop a report.pdf here, or start fresh — crawler list will use defaults.
            </div>
        </div>
        <div class="rs-actions">
            <label>
                <input type="file" accept=".pdf" x-ref="pdfUploadInput2"
                       @change="uploadReport($event.target.files[0]); $event.target.value=''"
                       style="display:none">
                <button type="button" class="btn sm primary" @click="$refs.pdfUploadInput2.click()">choose pdf</button>
            </label>
        </div>
    </div>

    <!-- Legacy + merge links -->
    <div class="slot-aux">
        <span id="legacy-banner">
            Coming from <em style="font-style:normal;color:var(--fg)">acm-statistics</em>?
            <a href="/pdf/legacy">download your legacy history →</a>
        </span>
        <span>Have history in two PDFs? <a href="/pdf/merge">merge them →</a></span>
    </div>

    <!-- ═══ STEP 2 — EDIT CRAWLERS ═══ -->
    <div class="step">
        <span class="n">02</span>
        <h2>Edit your crawlers</h2>
        <span class="hint">add or remove the online judges you want to track</span>
    </div>

    <div class="composer">
        <div class="field field-user">
            <span class="prefix">user</span>
            <input type="text" placeholder="username"
                   x-model="username"
                   @keydown.enter="addQuery()">
            <span class="at">@</span>
        </div>
        <div class="field field-crawler">
            <span class="prefix">crawler</span>
            <select x-model="selectedCrawler" @keydown.enter="addQuery()">
                <option value="">-- select --</option>
                <template x-for="[name, info] in Object.entries(crawlers)" :key="name">
                    <option :value="name" x-text="info.title"></option>
                </template>
                <option value="*">* all crawlers</option>
            </select>
        </div>
        <button type="button" class="btn" @click="addQuery()">
            add <span class="kbd">↵</span>
        </button>
        <div class="crawler-hint"
             x-show="selectedCrawler && selectedCrawler !== '*' && crawlers[selectedCrawler]?.description"
             x-text="(crawlers[selectedCrawler]?.title || '') + ' — ' + (crawlers[selectedCrawler]?.description || '')">
        </div>
    </div>

    <div class="slot-aux">
        <span>Not finding your crawler?
            <a href="https://github.com/Liu233w/ojhunt-lite/issues/new?title=Add%20crawler%20for%20%5BOJ%20Name%5D&body=%23%23%20Crawler%20Request%0A%0A**OJ%20URL%3A**%20%3C%21--%20paste%20the%20URL%20to%20the%20OJ%20here%2C%20e.g.%20https%3A%2F%2Fcodeforces.com%20--%3E%0A%0A**Username%20for%20testing%20(optional)%3A**"
               target="_blank" rel="noopener noreferrer">raise a ticket on GitHub →</a>
        </span>
    </div>

    <!-- ═══ STEP 3 — RUN QUERIES ═══ -->
    <div class="step">
        <span class="n">03</span>
        <h2>Run your queries</h2>
        <span class="hint">click ▶ on each card or use query all</span>
        <div class="step-actions">
            <button type="button" class="btn primary sm" @click="queryAll()" title="Ctrl/Cmd+Enter">
                query all <span class="kbd" x-text="isMac ? '⌘↵' : '^↵'"></span>
            </button>
            <button type="button" class="btn sm ghost danger"
                    x-show="queries.length > 0"
                    @click="clearAll()">clear all</button>
        </div>
    </div>

    <!-- Card grid -->
    <div class="grid" id="queries-tbl">
        <div class="card-empty" x-show="queries.length === 0">
            <pre>  no queries yet.</pre>
            <span>add a <span style="color:var(--fg-2)"><span style="color:var(--acc)">username@crawler</span></span> above to start.</span>
        </div>

        <template x-for="q in queries" :key="q.id">
            <div class="card" :class="{
                    'r-ok':   q.status === 'success',
                    'r-err':  q.status === 'error',
                    'r-load': q.status === 'loading',
                    'r-pend': q.status === 'pending'
                 }">

                <div class="c-hd">
                    <span class="title" x-text="crawlers[q.crawler]?.title || q.crawler"></span>
                    <span class="ident">
                        <span x-text="q.username"></span><span class="at">@</span><span class="crawler" x-text="q.crawler"></span>
                    </span>
                </div>

                <!-- OK / loading / pending: show stats -->
                <div class="c-body-row" x-show="q.status !== 'error'">
                    <div class="solved-wrap">
                        <span class="lbl">Solved</span>
                        <a href="#" class="solved-link"
                           x-show="q.status === 'success'"
                           @click.prevent="showDialog(q)"
                           x-text="q.solved?.toLocaleString('en-US')"></a>
                        <span class="dash" x-show="q.status !== 'success'">—</span>
                    </div>
                    <div class="subs-wrap" x-show="q.status === 'success'">
                        <span class="lbl">Submissions</span>
                        <span class="subs-val" x-text="q.submissions?.toLocaleString('en-US')"></span>
                    </div>
                </div>

                <!-- Error: show message -->
                <div class="c-err-msg" x-show="q.status === 'error'">
                    <a href="#" class="err-link"
                       @click.prevent="document.getElementById('dialog-error-' + q.id)?.showModal()"
                       x-text="q.error"></a>
                </div>

                <div class="c-ft">
                    <span class="status s-ok" x-show="q.status === 'success'">
                        ok<span class="t" x-text="' · ' + q.duration?.toFixed(2) + 's'"></span>
                    </span>
                    <span class="status s-err" x-show="q.status === 'error'">error</span>
                    <span class="status s-load" x-show="q.status === 'loading'">fetching<span class="loading-dots"></span></span>
                    <span class="status s-pend" x-show="q.status === 'pending'">pending</span>
                    <span class="actions">
                        <button class="iconbtn" x-show="q.status === 'pending'" title="query" @click="queryOne(q.id)">▶</button>
                        <button class="iconbtn" x-show="q.status === 'success' || q.status === 'error'" title="retry" @click="retryQuery(q.id)">↻</button>
                        <button class="iconbtn danger" x-show="q.status === 'loading'" title="stop" @click="stopQuery(q.id)">■</button>
                        <button class="iconbtn danger" x-show="q.status !== 'loading'" title="remove" @click="removeQuery(q.id)">×</button>
                    </span>
                </div>
            </div>
        </template>
    </div>

    <!-- ═══ STEP 4 — SAVE REPORT ═══ -->
    <div class="step" x-show="report.totalSolved !== null" x-cloak>
        <span class="n">04</span>
        <h2>Save your report</h2>
        <span class="hint">your pdf carries all crawler settings and history</span>
    </div>

    <div class="download-card summary" x-show="report.totalSolved !== null" x-cloak>
        <div class="dc-left summary-left">
            <div class="stat accent">
                <span class="n" x-text="report.totalSolved?.toLocaleString('en-US')"></span>
                <span class="l">total solved</span>
            </div>
            <div class="stat">
                <span class="n" x-text="report.totalSubmissions?.toLocaleString('en-US')"></span>
                <span class="l">total submissions</span>
            </div>
            <div class="stat">
                <span class="n">
                    <span x-text="queries.filter(q => q.status === 'success').length"></span><span style="color:var(--fg-4);font-size:1.1rem;font-weight:400" x-text="'/' + queries.length"></span>
                </span>
                <span class="l">crawlers ok</span>
            </div>
        </div>
        <div class="dc-right summary-right">
            <button type="button" class="btn primary" :disabled="isDownloading" @click="downloadReport()">
                download report.pdf<span class="loading-dots" x-show="isDownloading" x-cloak></span>
            </button>
            <span class="note">Store the PDF on your device — browser storage may be cleared at any time.</span>
        </div>
    </div>

    <!-- Solved list dialogs -->
    <template x-for="q in queries" :key="q.id">
        <dialog :id="'dialog-' + q.id" x-show="q.status === 'success'">
            <div class="dlg-hd">
                <span>problems_list</span>
                <span class="title">
                    <span x-text="crawlers[q.crawler]?.title || q.crawler"></span> /
                    <span x-text="q.username"></span> —
                    <template x-if="q.solvedList !== null">
                        <span><span x-text="q.solvedList.length.toLocaleString('en-US')"></span> problems</span>
                    </template>
                    <template x-if="q.solvedList === null">
                        <span>list not available</span>
                    </template>
                </span>
            </div>
            <div class="dlg-bd">
                <template x-if="q.solvedList !== null">
                    <span x-text="q.solvedList.sort().join(', ')"></span>
                </template>
                <template x-if="q.solvedList === null">
                    <span class="note">This crawler only reports a solved count — it does not expose the list of individual problem IDs.</span>
                </template>
            </div>
            <div class="dlg-ft">
                <button class="btn" @click="closeDialog(q.id)">close <span class="kbd">esc</span></button>
            </div>
        </dialog>
    </template>
    <template x-for="q in queries" :key="'err-' + q.id">
        <dialog :id="'dialog-error-' + q.id">
            <div class="dlg-hd">
                <span>error_detail</span>
                <span class="title">
                    <span x-text="crawlers[q.crawler]?.title || q.crawler"></span> /
                    <span x-text="q.username"></span>
                </span>
            </div>
            <div class="dlg-bd" x-text="q.error || ''"></div>
            <div class="dlg-ft">
                <button class="btn" @click="closeDialog('error-' + q.id)">close <span class="kbd">esc</span></button>
            </div>
        </dialog>
    </template>

</div>{# end x-data #}

<footer class="footer">
    <p>inspired by <a href="https://kidozh.com" target="_blank" rel="noopener noreferrer">jiduo zhang</a>'s
        西北工业大学ACM查询系统 (npuacm.info).</p>
    <p>a from-scratch rewrite of
        <a href="https://github.com/Liu233w/acm-statistics" target="_blank" rel="noopener noreferrer">acm-statistics</a>,
        no server-side storage — everything lives in your browser and your pdf.</p>
    <p>ai agent? <a href="/llms.txt">read the guide for llm →</a></p>
</footer>
{% endblock %}

{% block extra_scripts %}
<script>window.__CRAWLERS__ = {{ crawlers | tojson }};</script>
<script src="/assets/app.js?v={{ static_version }}"></script>
<script defer src="/assets/alpinejs-3.14.1.min.js"></script>
{% endblock %}
