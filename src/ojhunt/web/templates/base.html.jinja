<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}OJHunt Lite{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="describedby" href="/llms.txt" type="text/plain">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Noto+Sans+SC:wght@400;500&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg:    #0c0d0e;
        --bg-1:  #101214;
        --bg-2:  #14161a;
        --bg-3:  #191c21;
        --line:  #23262b;
        --line-2:#2e3238;
        --fg:    #e6e6e3;
        --fg-2:  #b7b9b8;
        --fg-3:  #8c9096;
        --fg-4:  #787c82;

        --acc-green:   oklch(0.82 0.17 148);
        --acc-amber:   oklch(0.82 0.17  72);
        --acc-cyan:    oklch(0.82 0.17 205);
        --acc-magenta: oklch(0.82 0.17 335);

        --acc: var(--acc-green);
        --acc-dim:    color-mix(in oklab, var(--acc) 22%, var(--bg));
        --acc-dimmer: color-mix(in oklab, var(--acc) 10%, var(--bg));

        --ok:   var(--acc);
        --load: oklch(0.82 0.17 72);
        --err:  oklch(0.72 0.19 24);
        --pend: var(--fg-4);

        --row-py: 0.7rem;
        --row-px: 1rem;
        --gap:    1rem;
        --fs:     13px;
        --fs-s:   12px;
        --fs-xs:  11px;

        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --cjk:  'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', var(--mono);
      }

      [data-accent="amber"]   { --acc: var(--acc-amber); }
      [data-accent="cyan"]    { --acc: var(--acc-cyan); }
      [data-accent="magenta"] { --acc: var(--acc-magenta); }

      [data-density="compact"] {
        --row-py: 0.4rem; --row-px: 0.75rem; --gap: 0.75rem;
        --fs: 12px; --fs-s: 11px; --fs-xs: 10px;
      }
      [data-density="roomy"] {
        --row-py: 1rem; --row-px: 1.25rem; --gap: 1.5rem;
        --fs: 14px; --fs-s: 13px; --fs-xs: 12px;
      }

      * { box-sizing: border-box; }
      html, body { background: var(--bg); color: var(--fg); }
      body {
        margin: 0;
        font-family: var(--mono);
        font-size: var(--fs);
        line-height: 1.55;
        font-feature-settings: "ss01","ss02","zero","cv11";
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      ::selection { background: var(--acc-dim); color: var(--fg); }
      a { color: var(--acc); text-decoration: none; }
      a:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
      button { font: inherit; color: inherit; cursor: pointer; }

      /* subtle CRT scanline */
      body::before {
        content: "";
        position: fixed; inset: 0;
        pointer-events: none; z-index: 1000;
        background: repeating-linear-gradient(
          to bottom,
          transparent 0px, transparent 2px,
          rgba(255,255,255,0.012) 2px, rgba(255,255,255,0.012) 3px
        );
      }

      /* ── TOP BAR ── */
      .topbar {
        position: sticky; top: 0; z-index: 50;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
        padding: 0 clamp(1rem, 3vw, 2rem);
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        height: 54px;
      }
      .tb-brand {
        display: flex; align-items: center; gap: 0.7rem;
        color: var(--fg); text-decoration: none;
        letter-spacing: 0.02em;
      }
      .tb-brand:hover { text-decoration: none; }
      .tb-brand img { height: 22px; image-rendering: auto; filter: saturate(0.9); }
      .tb-brand .wordmark { font-weight: 600; letter-spacing: 0.01em; }
      .tb-brand .dim { color: var(--fg-4); }

      .tb-nav {
        display: flex; gap: 0.1rem; align-items: center;
        font-size: var(--fs-s);
      }
      .tb-nav a {
        padding: 0.45rem 0.7rem;
        color: var(--fg-3);
        letter-spacing: 0.04em;
        text-transform: lowercase;
        border-radius: 2px;
        text-decoration: none;
      }
      .tb-nav a:hover { color: var(--fg); background: var(--bg-2); text-decoration: none; }
      .tb-nav a.active { color: var(--acc); }
      .tb-nav a.active::before { content: "> "; color: var(--acc); }
      .tb-star {
        display: inline-flex; align-items: center; gap: 0.4rem;
        border: 1px solid var(--line-2);
        padding: 0.35rem 0.7rem;
        margin-left: 0.5rem;
        color: var(--fg-2);
        font-size: var(--fs-xs);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .tb-star:hover { border-color: var(--acc); color: var(--acc); text-decoration: none; }
      .tb-star .star { color: var(--acc-amber); }

      /* ── PAGE ── */
      .page {
        margin: 0 auto;
        padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) 4rem;
      }

      /* ── HEADER ── */
      .header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 1.5rem 2rem;
        padding: 1rem 0 1.5rem;
        border-bottom: 1px dashed var(--line);
        margin-bottom: 2rem;
      }
      .header h1 { white-space: nowrap; }
      .header .mark {
        display: flex; align-items: center; gap: 0.75rem;
      }
      .header .mark img { height: 46px; }
      .header h1 {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .header .h-meta {
        font-size: var(--fs-xs);
        color: var(--fg-4);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .header .h-meta .cjk {
        font-family: var(--cjk); text-transform: none;
        letter-spacing: 0.05em; color: var(--fg-3); font-size: var(--fs-s);
      }
      .header .subtitle {
        color: var(--fg-3); font-size: var(--fs-s);
        justify-self: end; text-align: right; max-width: 32ch;
      }
      .header .subtitle .prompt { color: var(--acc); }

      /* ── SECTION HEAD ── */
      .section-head {
        display: flex; align-items: baseline; gap: 0.75rem;
        color: var(--fg-4); font-size: var(--fs-xs);
        text-transform: uppercase; letter-spacing: 0.12em;
        margin: 1.5rem 0 0.75rem;
      }
      .section-head .hash { color: var(--acc); }
      .section-head .rule { flex: 1; border-bottom: 1px dashed var(--line); }
      .section-head .count { color: var(--fg-3); font-variant-numeric: tabular-nums; }

      /* ── BANNERS ── */
      .banner {
        display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
        padding: 0.7rem 1rem;
        border: 1px solid var(--line);
        border-left: 3px solid var(--acc);
        background: var(--bg-1);
        font-size: var(--fs-s);
        color: var(--fg-2);
        margin-bottom: 1rem;
      }
      .banner .tag {
        color: var(--acc); font-weight: 600;
        letter-spacing: 0.06em; text-transform: uppercase; font-size: var(--fs-xs);
      }
      .banner .date { color: var(--fg); font-weight: 500; }
      .banner .help { color: var(--fg-4); font-size: var(--fs-xs); }
      .banner .spacer { flex: 1 1 auto; }
      .banner.legacy { border-left-color: var(--fg-4); }
      .banner.legacy .tag { color: var(--fg-3); }
      .banner button.x {
        background: none; border: 0; color: var(--fg-4);
        padding: 0.25rem 0.5rem; font-size: 1rem; line-height: 1;
      }
      .banner button.x:hover { color: var(--fg); }

      /* ── COMPOSER ── */
      .composer {
        border: 1px solid var(--line);
        background: var(--bg-1);
        margin-bottom: 1.5rem;
      }
      .composer .c-label {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.5rem 1rem;
        border-bottom: 1px solid var(--line);
        background: var(--bg-2);
        font-size: var(--fs-xs); color: var(--fg-3);
        text-transform: uppercase; letter-spacing: 0.1em;
      }
      .composer .c-label .dot { color: var(--acc); }
      .composer .c-body {
        padding: 0.9rem 1rem;
        display: grid;
        grid-template-columns: 1fr 1fr auto auto;
        gap: 0.5rem;
        align-items: center;
      }

      .field {
        display: flex; align-items: center;
        border: 1px solid var(--line);
        background: var(--bg);
        padding: 0 0.6rem;
        height: 36px;
        position: relative;
      }
      .field:focus-within { border-color: var(--acc); box-shadow: 0 0 0 2px var(--acc-dimmer); }
      .field .prefix { color: var(--fg-4); user-select: none; margin-right: 0.45rem; }
      .field select, .field input {
        background: transparent; border: 0; outline: none;
        color: var(--fg); font: inherit; width: 100%; padding: 0;
      }
      .field select option { background: var(--bg-1); color: var(--fg); }
      .field input::placeholder { color: var(--fg-4); }
      .field .at { color: var(--acc); margin: 0 0.3rem; }

      .btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        background: var(--bg-2); color: var(--fg);
        border: 1px solid var(--line-2);
        padding: 0 0.85rem; height: 36px;
        font: inherit; letter-spacing: 0.04em;
        text-transform: lowercase; white-space: nowrap;
      }
      .btn:hover { border-color: var(--acc); color: var(--acc); }
      .btn.primary { background: var(--acc); color: #0c0d0e; border-color: var(--acc); font-weight: 600; }
      .btn.primary:hover { background: var(--fg); border-color: var(--fg); color: var(--bg); }
      .btn.ghost { background: transparent; }
      .btn.danger:hover { border-color: var(--err); color: var(--err); }
      .btn .kbd {
        margin-left: 0.3rem; color: var(--fg-4); font-size: 10px;
        letter-spacing: 0.05em; border: 1px solid var(--line); padding: 0 0.3rem; border-radius: 2px;
      }
      .btn.primary .kbd { color: rgba(12,13,14,0.75); border-color: rgba(12,13,14,0.35); }
      .btn.xs { height: 26px; padding: 0 0.55rem; font-size: var(--fs-xs); }

      .crawler-hint {
        grid-column: 1 / -1;
        font-size: var(--fs-xs); color: var(--fg-3); padding-left: 0.1rem;
      }
      .crawler-hint::before { content: "ℹ "; color: var(--fg-4); }

      /* ── TABLE ── */
      .tbl-wrap {
        border: 1px solid var(--line);
        background: var(--bg-1);
        overflow: hidden;
      }
      .tbl {
        width: 100%; border-collapse: collapse;
        table-layout: fixed;
        font-variant-numeric: tabular-nums;
      }
      .tbl thead th {
        text-align: left;
        padding: 0.55rem var(--row-px);
        border-bottom: 1px solid var(--line);
        font-size: var(--fs-xs); text-transform: uppercase;
        letter-spacing: 0.1em; color: var(--fg-4);
        font-weight: 500; background: var(--bg-2);
      }
      .tbl tbody td {
        padding: var(--row-py) var(--row-px);
        border-bottom: 1px solid var(--line);
        vertical-align: middle;
      }
      .tbl tbody tr:last-child td { border-bottom: 0; }
      .tbl tbody tr { position: relative; }

      /* ── ROW STATUS: bar variant ── */
      [data-row-style="bar"] .tbl tbody td:first-child { border-left: 3px solid transparent; }
      [data-row-style="bar"] .tbl tbody tr.r-ok   td:first-child { border-left-color: var(--ok); }
      [data-row-style="bar"] .tbl tbody tr.r-err  td:first-child { border-left-color: var(--err); }
      [data-row-style="bar"] .tbl tbody tr.r-load td:first-child { border-left-color: var(--load); }
      [data-row-style="bar"] .tbl tbody tr.r-pend td:first-child { border-left-color: var(--line-2); }

      /* ── ROW STATUS: tint variant ── */
      [data-row-style="tint"] .tbl tbody tr.r-ok   { background: color-mix(in oklab, var(--ok)   7%, var(--bg-1)); }
      [data-row-style="tint"] .tbl tbody tr.r-err  { background: color-mix(in oklab, var(--err)  8%, var(--bg-1)); }
      [data-row-style="tint"] .tbl tbody tr.r-load { background: color-mix(in oklab, var(--load) 6%, var(--bg-1)); }
      [data-row-style="tint"] .tbl tbody tr.r-pend { background: var(--bg-1); }

      /* ── TABLE CELL CONTENT ── */
      .tbl .crawler { color: var(--fg); }
      .tbl .crawler .tag {
        color: var(--fg-3); font-size: var(--fs-xs); letter-spacing: 0.04em;
      }
      .tbl .crawler .tag::before { content: "@"; margin-right: 0.05em; }
      .tbl .user { color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; max-width: 100%; }
      .tbl .num { color: var(--fg); font-weight: 500; }
      .tbl .num.big { font-size: calc(var(--fs) + 1px); }
      .tbl .num.dim { color: var(--fg-4); font-weight: 400; }
      .tbl .status {
        display: inline-flex; align-items: center; gap: 0.4rem;
        font-size: var(--fs-s);
      }
      .tbl .status::before {
        content: ""; width: 6px; height: 6px;
        background: currentColor; display: inline-block; border-radius: 1px;
      }
      .tbl .status.s-ok   { color: var(--ok); }
      .tbl .status.s-err  { color: var(--err); }
      .tbl .status.s-load { color: var(--load); }
      .tbl .status.s-pend { color: var(--fg-4); }
      .tbl .status .t { color: var(--fg-3); font-size: var(--fs-xs); margin-left: 0.2rem; }
      a.status { text-decoration: none; }
      a.status:hover { text-decoration: none; opacity: 0.8; }

      .tbl .actions { text-align: right; white-space: nowrap; }
      .tbl .actions .iconbtn {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--fg-3);
        width: 30px; height: 30px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 14px;
        margin-left: 4px;
      }
      .tbl .actions .iconbtn:hover { color: var(--acc); border-color: var(--acc); }
      .tbl .actions .iconbtn.danger:hover { color: var(--err); border-color: var(--err); }

      .solved-link {
        color: var(--acc);
        border-bottom: 1px dashed var(--acc); padding-bottom: 1px;
      }
      .solved-link:hover { color: var(--fg); border-bottom-color: var(--fg); text-decoration: none; }

      .err-link {
        display: block; width: 100%;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        color: var(--fg-3); font-size: var(--fs-xs); text-decoration: none;
      }
      .err-link:hover { color: var(--err); text-decoration: none; }

      .loading-dots::after {
        content: ""; animation: dots 1.4s steps(4,end) infinite;
      }
      @keyframes dots {
        0%  { content: ""; } 25% { content: "."; }
        50% { content: ".."; } 75% { content: "..."; }
      }

      .empty {
        padding: 2.5rem 1rem; text-align: center;
        color: var(--fg-4); font-size: var(--fs-s);
      }
      .empty pre { margin: 0 0 0.75rem; color: var(--fg-3); font-size: var(--fs-xs); line-height: 1.4; }
      .empty .hint-cmd { color: var(--fg-2); }
      .empty .hint-cmd .hl { color: var(--acc); }

      /* ── SUMMARY ── */
      .summary {
        margin-top: 1.5rem;
        border: 1px solid var(--line);
        background: var(--bg-1);
        display: grid; grid-template-columns: 1fr auto; align-items: center;
      }
      .summary-left {
        padding: 1rem 1.25rem;
        display: flex; flex-wrap: wrap; align-items: baseline; gap: 1.5rem;
      }
      .summary .stat { display: flex; flex-direction: column; }
      .summary .stat .n {
        font-size: 1.75rem; font-weight: 600; color: var(--acc);
        letter-spacing: -0.01em; line-height: 1.1;
      }
      .summary .stat .l {
        font-size: var(--fs-xs); color: var(--fg-4);
        text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.2rem;
      }
      .summary .sep { color: var(--fg-4); font-size: 1.5rem; line-height: 1; align-self: center; }
      .summary-right {
        padding: 1rem 1.25rem;
        border-left: 1px solid var(--line);
        display: flex; flex-direction: row-reverse; gap: 1rem; align-items: center;
      }
      .summary-right .note {
        font-size: var(--fs-xs); color: var(--fg-4); max-width: 28ch; line-height: 1.4;
        text-align: right;
      }

      /* ── FOOTER ── */
      .footer {
        margin-top: 4rem; padding-top: 1.5rem;
        border-top: 1px dashed var(--line);
        color: var(--fg-4); font-size: var(--fs-xs);
        display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: end;
      }
      .footer p { margin: 0 0 0.4rem; line-height: 1.6; }
      .footer .ascii {
        color: var(--fg-4); white-space: pre; font-size: 10px;
        line-height: 1.1; text-align: right; opacity: 0.7;
      }

      /* ── CRAWLERS TABLE ── */
      .clw-tbl .tag-cell { color: var(--acc); letter-spacing: 0.04em; }
      .clw-tbl .desc { color: var(--fg-3); font-size: var(--fs-s); }
      .clw-tbl .name { color: var(--fg); }
      .clw-tbl .name a { color: var(--fg); }
      .clw-tbl .name a:hover { color: var(--acc); }

      /* ── ABOUT ── */
      .about-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem;
      }
      .card { border: 1px solid var(--line); background: var(--bg-1); }
      .card-hd {
        padding: 0.55rem 1rem;
        background: var(--bg-2);
        border-bottom: 1px solid var(--line);
        font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.1em;
        color: var(--fg-3);
        display: flex; align-items: center; gap: 0.5rem;
      }
      .card-hd .prompt { color: var(--acc); }
      .row-item {
        display: grid; grid-template-columns: 110px 1fr auto;
        gap: 1rem; padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--line);
        align-items: center; color: var(--fg); font-size: var(--fs-s);
        text-decoration: none;
      }
      .row-item:last-child { border-bottom: 0; }
      .row-item:hover { background: var(--bg-2); }
      .row-item .k {
        color: var(--fg-4); text-transform: uppercase;
        font-size: var(--fs-xs); letter-spacing: 0.08em;
      }
      .row-item .v { color: var(--fg-2); word-break: break-all; }
      .row-item .v .cjk { font-family: var(--cjk); color: var(--fg); }
      .row-item .v .highlight { color: var(--fg); }
      .row-item .arr { color: var(--fg-4); font-size: var(--fs-s); }
      .row-item:hover .arr { color: var(--acc); }

      /* ── DIALOG ── */
      dialog {
        background: var(--bg-1); color: var(--fg);
        border: 1px solid var(--line-2);
        padding: 0; max-width: 640px; width: calc(100vw - 2rem);
        font-family: var(--mono);
      }
      dialog::backdrop { background: rgba(0,0,0,0.72); }
      .dlg-hd {
        display: flex; justify-content: space-between; align-items: center;
        padding: 0.7rem 1rem;
        border-bottom: 1px solid var(--line);
        background: var(--bg-2);
        font-size: var(--fs-s); color: var(--fg-3);
        text-transform: uppercase; letter-spacing: 0.08em;
      }
      .dlg-hd .title { color: var(--fg); text-transform: none; letter-spacing: 0.02em; }
      .dlg-bd {
        padding: 1rem; max-height: 60vh; overflow: auto;
        font-size: var(--fs-s); color: var(--fg-2); line-height: 1.7; word-break: break-all;
      }
      .dlg-ft {
        padding: 0.7rem 1rem;
        border-top: 1px solid var(--line);
        display: flex; justify-content: flex-end; gap: 0.5rem;
        background: var(--bg-1);
      }

      /* focus */
      :focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }

      /* Alpine cloak */
      [x-cloak] { display: none !important; }

      /* ── MOBILE ── */
      @media (max-width: 640px) {
        .topbar {
          height: auto; padding: 0.5rem 0.75rem;
          grid-template-columns: 1fr; gap: 0.4rem;
        }
        .tb-nav { flex-wrap: wrap; justify-content: flex-start; gap: 0.1rem; font-size: var(--fs-xs); }
        .tb-nav a { padding: 0.35rem 0.5rem; }
        .tb-star { margin-left: 0; padding: 0.3rem 0.55rem; }

        .header {
          grid-template-columns: 1fr;
          gap: 1rem; padding: 0.5rem 0 1rem; margin-bottom: 1.25rem;
        }
        .header h1 { white-space: normal; font-size: 1.1rem; line-height: 1.2; }
        .header .mark img { height: 36px; }
        .header .subtitle { justify-self: start; text-align: left; font-size: var(--fs-xs); max-width: none; }

        .banner { gap: 0.4rem 0.75rem; padding: 0.6rem 0.75rem; }
        .banner .spacer { flex-basis: 100%; height: 0; }

        .composer .c-body {
          grid-template-columns: 1fr 1fr; gap: 0.4rem; padding: 0.7rem 0.75rem;
        }
        .composer .c-label { padding: 0.45rem 0.75rem; }
        .composer .c-body .field-user,
        .composer .c-body .field-crawler { grid-column: 1 / -1; }
        .btn { padding: 0 0.65rem; }
        .btn .kbd { display: none; }

        /* ── HOME: table → card layout ── */
        #page-home .tbl-wrap { border: 0; background: transparent; }
        #page-home .tbl,
        #page-home .tbl thead,
        #page-home .tbl tbody,
        #page-home .tbl tr,
        #page-home .tbl td,
        #page-home .tbl th { display: block; }
        #page-home .tbl thead { display: none; }
        #page-home .tbl tbody tr {
          border: 1px solid var(--line); background: var(--bg-1);
          margin-bottom: 0.5rem; padding: 0.2rem 0;
          display: grid; grid-template-columns: 1fr 1fr; gap: 0;
        }
        /* bar variant: border on card (tr), not on td:first-child */
        [data-row-style="bar"] #page-home .tbl tbody tr.r-ok   { border-left: 3px solid var(--ok); }
        [data-row-style="bar"] #page-home .tbl tbody tr.r-err  { border-left: 3px solid var(--err); }
        [data-row-style="bar"] #page-home .tbl tbody tr.r-load { border-left: 3px solid var(--load); }
        [data-row-style="bar"] #page-home .tbl tbody tr.r-pend { border-left: 3px solid var(--line-2); }
        /* cancel desktop td:first-child bar for home */
        [data-row-style="bar"] #page-home .tbl tbody tr td:first-child { border-left: 0 !important; }

        #page-home .tbl tbody td {
          border-bottom: 0; padding: 0.3rem 0.75rem;
          display: flex; align-items: flex-start; gap: 0.5rem; font-size: var(--fs-s);
        }
        #page-home .tbl tbody td::before {
          content: attr(data-lbl);
          color: var(--fg-4); font-size: var(--fs-xs); text-transform: uppercase;
          letter-spacing: 0.08em; min-width: 72px; flex-shrink: 0;
        }
        #page-home .tbl tbody td.crawler {
          grid-column: 1 / -1; border-bottom: 1px solid var(--line);
          padding-bottom: 0.5rem; margin-bottom: 0.25rem; font-size: var(--fs);
        }
        #page-home .tbl tbody td.crawler::before { display: none; }
        #page-home .tbl tbody td.actions { grid-column: 1 / -1; justify-content: flex-end; }
        #page-home .tbl tbody td.actions::before { display: none; }
        #page-home .tbl tbody td[colspan] { grid-column: 1 / -1; }
        #page-home .tbl tbody tr { position: relative; }

        /* ── CRAWLERS: table → card layout ── */
        #page-crawlers .tbl-wrap { border: 0; background: transparent; }
        #page-crawlers .tbl,
        #page-crawlers .tbl thead,
        #page-crawlers .tbl tbody,
        #page-crawlers .tbl tr,
        #page-crawlers .tbl td,
        #page-crawlers .tbl th { display: block; }
        #page-crawlers .tbl thead { display: none; }
        #page-crawlers .tbl tbody tr {
          border: 1px solid var(--line); background: var(--bg-1);
          margin-bottom: 0.5rem; padding: 0.5rem 0.75rem;
          display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.75rem;
        }
        [data-row-style="bar"] #page-crawlers .tbl tbody tr.r-ok   { border-left: 3px solid var(--ok); }
        [data-row-style="bar"] #page-crawlers .tbl tbody tr.r-err  { border-left: 3px solid var(--err); }
        [data-row-style="bar"] #page-crawlers .tbl tbody tr.r-pend { border-left: 3px solid var(--line-2); }
        /* cancel desktop td:first-child bar for crawlers */
        [data-row-style="bar"] #page-crawlers .tbl tbody tr td:first-child,
        [data-row-style="bar"] #page-crawlers .tbl tbody tr.r-ok   td:first-child,
        [data-row-style="bar"] #page-crawlers .tbl tbody tr.r-err  td:first-child,
        [data-row-style="bar"] #page-crawlers .tbl tbody tr.r-pend td:first-child { border-left: 0 !important; }

        #page-crawlers .tbl tbody td { border-bottom: 0; padding: 0; font-size: var(--fs-s); }
        #page-crawlers .tbl tbody td:nth-child(1) {
          color: var(--acc); font-size: var(--fs-xs);
          text-transform: uppercase; letter-spacing: 0.08em; align-self: center;
        }
        #page-crawlers .tbl tbody td:nth-child(2) { color: var(--fg); font-weight: 500; }
        #page-crawlers .tbl tbody td:nth-child(3) { grid-column: 1 / -1; color: var(--fg-3); }
        #page-crawlers .tbl tbody td:nth-child(4) { grid-column: 1 / -1; }

        /* ── SUMMARY ── */
        .summary { grid-template-columns: 1fr; }
        .summary-left { padding: 0.85rem 1rem; gap: 0.75rem 1.25rem; }
        .summary .stat .n { font-size: 1.5rem; }
        .summary .sep { display: none; }
        .summary-right { border-left: 0; border-top: 1px solid var(--line); padding: 0.85rem 1rem; }

        /* ── ABOUT ── */
        .about-grid { grid-template-columns: 1fr; }
        .row-item {
          grid-template-columns: 1fr auto;
          grid-template-rows: auto auto;
          gap: 0.1rem 0.5rem; padding: 0.65rem 0.85rem;
        }
        .row-item .k { grid-column: 1; grid-row: 1; }
        .row-item .v { grid-column: 1 / -1; grid-row: 2; font-size: var(--fs-s); }
        .row-item .arr { grid-column: 2; grid-row: 1; }

        /* ── FOOTER ── */
        .footer { grid-template-columns: 1fr; }
        .footer .ascii { display: none; }

        /* scanline: disable on mobile */
        body::before { display: none; }
      }
    </style>
    {% block extra_head %}{% endblock %}
</head>
<body data-accent="green" data-density="comfortable" data-row-style="bar">

<nav class="topbar">
    <a href="/" class="tb-brand">
        <img src="/assets/logo.png" alt="OJHunt Logo">
        <span><span class="dim">{ </span><span class="wordmark">ojhunt-lite</span><span class="dim"> }</span></span>
    </a>
    <div class="tb-nav">
        <a href="/" class="nav-home">home</a>
        <a href="/crawlers" class="nav-crawlers">crawlers</a>
        <a href="/about" class="nav-about">about</a>
        <a href="/pdf" class="nav-pdf">pdf-tools</a>
        <a href="/docs" class="nav-docs" target="_blank" rel="noopener">api-docs</a>
        <a class="tb-star" href="https://github.com/Liu233w/ojhunt-lite" target="_blank" rel="noopener noreferrer">
            <span class="star">★</span> github
        </a>
    </div>
</nav>

<main class="page" id="{% block page_id %}main{% endblock %}" style="max-width: {% block page_max_width %}1180px{% endblock %};">
    {% block content %}{% endblock %}
</main>

<script>
(function () {
    var p = location.pathname;
    if (p === '/') document.querySelector('.nav-home')?.classList.add('active');
    else if (p.startsWith('/crawlers')) document.querySelector('.nav-crawlers')?.classList.add('active');
    else if (p.startsWith('/about')) document.querySelector('.nav-about')?.classList.add('active');
    else if (p.startsWith('/pdf')) document.querySelector('.nav-pdf')?.classList.add('active');
    else if (p.startsWith('/docs')) document.querySelector('.nav-docs')?.classList.add('active');
})();
</script>
{% block extra_scripts %}{% endblock %}
</body>
</html>
