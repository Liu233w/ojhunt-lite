<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}OJHunt Lite{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="describedby" href="/llms.txt" type="text/plain">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/base.css?v={{ static_version }}">
    {% block extra_head %}{% endblock %}
</head>
<body data-accent="green">

<nav class="topbar">
    <a href="/" class="tb-brand">
        <img src="/assets/logo.png" alt="OJHunt Logo">
        <span><span class="dim">{ </span><span class="wordmark">ojhunt-lite</span><span class="dim"> }</span></span>
    </a>
    <div class="tb-nav">
        <a href="/" class="nav-home">home</a>
        <a href="/crawlers" class="nav-crawlers">crawlers</a>
        <a href="/pdf" class="nav-pdf">pdf-tools</a>
        <a href="/about" class="nav-about">about</a>
        <a href="/docs" class="nav-docs" target="_blank" rel="noopener">api-docs</a>
        <a class="tb-star" href="https://github.com/Liu233w/ojhunt-lite" target="_blank" rel="noopener noreferrer">
            <span class="star">★</span> github
        </a>
    </div>
</nav>

<main class="page" id="{% block page_id %}main{% endblock %}" style="max-width: {% block page_max_width %}1180px{% endblock %};">
    {% block content %}{% endblock %}
</main>

<script>
(function () {
    var p = location.pathname;
    if (p === '/') document.querySelector('.nav-home')?.classList.add('active');
    else if (p.startsWith('/crawlers')) document.querySelector('.nav-crawlers')?.classList.add('active');
    else if (p.startsWith('/about')) document.querySelector('.nav-about')?.classList.add('active');
    else if (p.startsWith('/pdf')) document.querySelector('.nav-pdf')?.classList.add('active');
    else if (p.startsWith('/docs')) document.querySelector('.nav-docs')?.classList.add('active');
})();
</script>

<div id="cookie-banner" class="cookie-banner" hidden>
    <p class="cookie-text">
        This site is served through Cloudflare, which sets cookies needed for security and performance.
        By using this website, you agree to our use of cookies.
    </p>
    <button type="button" id="cookie-ok" class="cookie-ok">OK</button>
</div>
<script>
(function () {
    var KEY = 'ojhunt-cookie-consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;
    try {
        if (localStorage.getItem(KEY) === '1') return;
    } catch (e) { /* localStorage unavailable — show the notice anyway */ }
    banner.hidden = false;
    document.getElementById('cookie-ok')?.addEventListener('click', function () {
        try { localStorage.setItem(KEY, '1'); } catch (e) { /* ignore */ }
        banner.hidden = true;
    });
})();
</script>
{% block extra_scripts %}{% endblock %}
</body>
</html>
