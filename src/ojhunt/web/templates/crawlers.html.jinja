{% extends "base.html.jinja" %}

{% block extra_head %}
<style>
  /* ── TABLE BASE (crawlers-only; removed from base.html in cards redesign) ── */
  .tbl-wrap { border: 1px solid var(--line); background: var(--bg-1); overflow-x: auto; }
  .tbl { width: 100%; border-collapse: collapse; }
  .tbl thead th {
    padding: 0.5rem 0.85rem; text-align: left;
    font-size: var(--fs-xs); color: var(--fg-4);
    text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;
    border-bottom: 1px solid var(--line); white-space: nowrap;
  }
  .tbl tbody tr { border-bottom: 1px solid var(--line); }
  .tbl tbody tr:last-child { border-bottom: 0; }
  .tbl tbody td { padding: 0.5rem 0.85rem; color: var(--fg-2); vertical-align: middle; }
  .tbl tbody tr.r-ok   td:first-child { border-left: 3px solid var(--ok); }
  .tbl tbody tr.r-err  td:first-child { border-left: 3px solid var(--err); }
  .tbl tbody tr.r-pend td:first-child { border-left: 3px solid var(--line-2); }

  /* ── CRAWLERS TABLE ── */
  .clw-tbl .tag-cell { color: var(--acc); letter-spacing: 0.04em; }
  .clw-tbl .desc { color: var(--fg-3); font-size: var(--fs-s); }
  .clw-tbl .name { color: var(--fg); }
  .clw-tbl .name a { color: var(--fg); }
  .clw-tbl .name a:hover { color: var(--acc); }

  @media (max-width: 640px) {
    /* ── CRAWLERS: table → card layout ── */
    #page-crawlers .tbl-wrap { border: 0; background: transparent; }
    #page-crawlers .tbl,
    #page-crawlers .tbl thead,
    #page-crawlers .tbl tbody,
    #page-crawlers .tbl tr,
    #page-crawlers .tbl td,
    #page-crawlers .tbl th { display: block; }
    #page-crawlers .tbl thead { display: none; }
    #page-crawlers .tbl tbody tr {
      border: 1px solid var(--line); background: var(--bg-1);
      margin-bottom: 0.5rem; padding: 0.5rem 0.75rem;
      display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.75rem;
    }
    #page-crawlers .tbl tbody tr.r-ok   { border-left: 3px solid var(--ok); }
    #page-crawlers .tbl tbody tr.r-err  { border-left: 3px solid var(--err); }
    #page-crawlers .tbl tbody tr.r-pend { border-left: 3px solid var(--line-2); }
    /* Cancel the desktop td:first-child left-bar; border is on tr in mobile */
    #page-crawlers .tbl tbody tr td:first-child { border-left: 0 !important; }

    #page-crawlers .tbl tbody td { border-bottom: 0; padding: 0; font-size: var(--fs-s); }
    #page-crawlers .tbl tbody td:nth-child(1) {
      color: var(--acc); font-size: var(--fs-xs);
      text-transform: uppercase; letter-spacing: 0.08em; align-self: center;
    }
    #page-crawlers .tbl tbody td:nth-child(2) { color: var(--fg); font-weight: 500; }
    #page-crawlers .tbl tbody td:nth-child(3) { grid-column: 1 / -1; color: var(--fg-3); }
    #page-crawlers .tbl tbody td:nth-child(4) { grid-column: 1 / -1; }
  }
</style>
{% endblock %}

{% block title %}Supported Crawlers - OJHunt Lite{% endblock %}

{% block page_id %}page-crawlers{% endblock %}

{% block content %}
<header class="header">
    <div class="mark">
        <img src="/assets/logo.png" alt="OJHunt Logo">
        <div>
            <h1>Supported Crawlers</h1>
            <div class="h-meta"><span class="cjk">支持的爬虫</span> · {{ crawlers | length }} total</div>
        </div>
    </div>
    <div class="subtitle">
        <span class="prompt">$</span> ojhunt --list
    </div>
</header>

<div class="tbl-wrap">
    <table class="tbl clw-tbl">
        <thead>
            <tr>
                <th style="width:20%">tag</th>
                <th style="width:25%">name</th>
                <th>description</th>
                <th style="width:12%">status</th>
            </tr>
        </thead>
        <tbody>
            {% for c in crawlers %}
            <tr class="{% if c.availability.status.value == 'online' %}r-ok{% elif c.availability.status.value == 'offline' %}r-err{% else %}r-pend{% endif %}">
                <td><span class="tag-cell">{{ c.name }}</span></td>
                <td class="name">
                    {% if c.url %}
                    <a href="{{ c.url }}" target="_blank" rel="noopener noreferrer">{{ c.title }}</a>
                    {% else %}
                    {{ c.title }}
                    {% endif %}
                </td>
                <td class="desc">{{ c.description }}</td>
                <td>
                    {% if c.availability.status.value == "online" %}
                    <span class="status s-ok">online</span>
                    {% elif c.availability.status.value == "offline" %}
                    <span class="status s-err"{% if c.availability.error %} title="{{ c.availability.error }}"{% endif %}>offline</span>
                    {% else %}
                    <span class="status s-pend">waiting</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<footer class="footer">
    <p>status is checked live from the server; offline crawlers are usually temporary — the site might be down or the crawler's endpoint may have changed.</p>
    <p>want to add a crawler? <a href="https://github.com/Liu233w/ojhunt-lite/blob/main/docs/development.md" target="_blank" rel="noopener noreferrer">see docs/development.md →</a></p>
</footer>
{% endblock %}
