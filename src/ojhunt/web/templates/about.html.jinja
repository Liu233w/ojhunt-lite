{% extends "base.html.jinja" %}

{% block extra_head %}
<style>
  /* ── ABOUT ── */
  .about-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem;
  }
  .card { border: 1px solid var(--line); background: var(--bg-1); }
  .card-hd {
    padding: 0.55rem 1rem;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--fg-3);
    display: flex; align-items: center; gap: 0.5rem;
  }
  .card-hd .prompt { color: var(--acc); }
  .row-item {
    display: grid; grid-template-columns: 110px 1fr auto;
    gap: 1rem; padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--line);
    align-items: center; color: var(--fg); font-size: var(--fs-s);
    text-decoration: none;
  }
  .row-item:last-child { border-bottom: 0; }
  .row-item:hover { background: var(--bg-2); }
  .row-item .k {
    color: var(--fg-4); text-transform: uppercase;
    font-size: var(--fs-xs); letter-spacing: 0.08em;
  }
  .row-item .v { color: var(--fg-2); word-break: break-all; }
  .row-item .v .cjk { color: var(--fg); }
  .row-item .v .highlight { color: var(--fg); }
  .row-item .arr { color: var(--fg-4); font-size: var(--fs-s); }
  .row-item:hover .arr { color: var(--acc); }

  @media (max-width: 640px) {
    .about-grid { grid-template-columns: 1fr; }
    .row-item {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 0.1rem 0.5rem; padding: 0.65rem 0.85rem;
    }
    .row-item .k { grid-column: 1; grid-row: 1; }
    .row-item .v { grid-column: 1 / -1; grid-row: 2; font-size: var(--fs-s); }
    .row-item .arr { grid-column: 2; grid-row: 1; }
  }
</style>
{% endblock %}

{% block title %}About - OJHunt Lite{% endblock %}

{% block page_id %}page-about{% endblock %}

{% block page_max_width %}900px{% endblock %}

{% block content %}
<header class="header">
    <div class="mark">
        <img src="/assets/logo.png" alt="OJHunt Logo">
        <div>
            <h1>About OJHunt Lite</h1>
            <div class="h-meta"><span class="cjk">关于本项目</span></div>
        </div>
    </div>
    <div class="subtitle">
        <span class="prompt">$</span> ojhunt --help
    </div>
</header>

<div class="about-grid">
    <!-- about_us -->
    <div class="card">
        <div class="card-hd"><span class="prompt">&gt;</span> about_us</div>
        <a class="row-item" href="https://github.com/Liu233w/ojhunt-lite/blob/master/README.md#contributors-" target="_blank" rel="noopener noreferrer">
            <span class="k">developed</span>
            <span class="v"><span class="highlight">Shumin Liu</span> &amp; contributors</span>
            <span class="arr">↗</span>
        </a>
        <a class="row-item" href="mailto:support@ojhunt.com">
            <span class="k">contact</span>
            <span class="v">support@ojhunt.com</span>
            <span class="arr">✉</span>
        </a>
        <a class="row-item" href="https://github.com/Liu233w/ojhunt-lite" target="_blank" rel="noopener noreferrer">
            <span class="k">github</span>
            <span class="v">Liu233w/ojhunt-lite</span>
            <span class="arr">↗</span>
        </a>
        <a class="row-item" href="https://t.me/ojhunt" target="_blank" rel="noopener noreferrer">
            <span class="k">telegram</span>
            <span class="v">t.me/ojhunt</span>
            <span class="arr">↗</span>
        </a>
        <a class="row-item" href="https://discord.gg/9BsnDaHpTU" target="_blank" rel="noopener noreferrer">
            <span class="k">discord</span>
            <span class="v">OJ Analyzer Development</span>
            <span class="arr">↗</span>
        </a>
        <a class="row-item" href="https://github.com/Liu233w/ojhunt-lite/discussions/new/choose" target="_blank" rel="noopener noreferrer">
            <span class="k">discuss</span>
            <span class="v">GitHub Discussions — ask &amp; share</span>
            <span class="arr">↗</span>
        </a>
    </div>

    <!-- development -->
    <div class="card">
        <div class="card-hd"><span class="prompt">&gt;</span> development</div>
        <a class="row-item" href="/docs" target="_blank" rel="noopener noreferrer">
            <span class="k">api docs</span>
            <span class="v">Swagger UI — /docs</span>
            <span class="arr">↗</span>
        </a>
        <a class="row-item" href="https://github.com/Liu233w/ojhunt-lite/blob/main/docs/cli.md" target="_blank" rel="noopener noreferrer">
            <span class="k">cli</span>
            <span class="v">docs/cli.md</span>
            <span class="arr">↗</span>
        </a>
        <a class="row-item" href="https://github.com/Liu233w/ojhunt-lite/blob/main/docs/development.md" target="_blank" rel="noopener noreferrer">
            <span class="k">contribute</span>
            <span class="v">docs/development.md</span>
            <span class="arr">↗</span>
        </a>
    </div>

    <!-- special thanks -->
    <div class="card">
        <div class="card-hd">
            <span class="prompt">&gt;</span>
            <span class="cjk" style="color:var(--fg-3); text-transform:none; letter-spacing:0.02em;">特别鸣谢</span>
            · special thanks to
        </div>
        <div class="row-item">
            <span class="k">club</span>
            <span class="v"><span class="cjk">西北工业大学 ACM 协会技术组</span></span>
            <span class="arr"></span>
        </div>
        <div class="row-item">
            <span class="k">address</span>
            <span class="v"><span class="cjk">陕西省西安市长安区<br>西北工业大学长安校区计算机学院 110 室</span></span>
            <span class="arr"></span>
        </div>
        <a class="row-item" href="https://jq.qq.com/?_wv=1027&k=5qgzfQc" target="_blank" rel="noopener noreferrer">
            <span class="k">qq 群</span>
            <span class="v">198820787</span>
            <span class="arr">↗</span>
        </a>
        <a class="row-item" href="#" onclick="document.getElementById('wechat-dialog').showModal(); return false;">
            <span class="k">wechat</span>
            <span class="v"><span class="cjk">微信公众号</span> — click for qr</span>
            <span class="arr">▣</span>
        </a>
    </div>

    <!-- system info -->
    <div class="card">
        <div class="card-hd"><span class="prompt">&gt;</span> system_info</div>
        {% if build_time %}
        <div class="row-item">
            <span class="k">build</span>
            <span class="v">{{ build_time }}</span>
            <span class="arr"></span>
        </div>
        {% endif %}
        {% if git_commit_sha %}
        <a class="row-item" href="https://github.com/Liu233w/ojhunt-lite/tree/{{ git_commit_sha }}" target="_blank" rel="noopener noreferrer">
            <span class="k">commit</span>
            <span class="v"><span style="color:var(--acc)">{{ git_commit_sha[:7] }}</span></span>
            <span class="arr">↗</span>
        </a>
        {% endif %}
        {% if not build_time and not git_commit_sha %}
        <div class="row-item">
            <span class="k">build</span>
            <span class="v" style="color:var(--fg-4)">not available</span>
            <span class="arr"></span>
        </div>
        {% endif %}
        <div class="row-item">
            <span class="k">license</span>
            <span class="v">BSD 2-Clause</span>
            <span class="arr"></span>
        </div>
    </div>
</div>

<footer class="footer">
    <div>
        <p>inspired by <a href="https://kidozh.com" target="_blank" rel="noopener noreferrer">jiduo zhang</a>'s
            西北工业大学ACM查询系统 (npuacm.info).</p>
    </div>
</footer>

<!-- WeChat QR dialog -->
<dialog id="wechat-dialog">
    <div class="dlg-hd">
        <span>wechat_qr</span>
        <span class="title"><span>微信公众号</span></span>
    </div>
    <div class="dlg-bd" style="text-align:center;">
        <img src="/assets/wechat.jpg" alt="WeChat QR Code" style="max-width:250px; width:100%;">
    </div>
    <div class="dlg-ft">
        <button class="btn" onclick="document.getElementById('wechat-dialog').close()">close</button>
    </div>
</dialog>
{% endblock %}
