{% extends "base.html.jinja" %}

{% block extra_head %}
    <style>
        * { box-sizing: border-box; }

        .pdf-subnav {
            display: flex;
            gap: 0.25rem;
            padding: 0.5rem 0;
            border-bottom: 1px solid #e5e7eb;
            margin-bottom: 1.5rem;
        }
        .pdf-subnav a {
            padding: 0.35rem 0.75rem;
            border-radius: 5px;
            text-decoration: none;
            color: #444;
            font-size: 0.9rem;
        }
        .pdf-subnav a:hover { background: #f3f4f6; color: #111; }
        .pdf-subnav a.active {
            background: #0066cc;
            color: #fff;
            font-weight: 600;
        }

        .pdf-page h1 { margin: 0 0 0.5rem 0; font-size: 1.5rem; }
        .pdf-page .subtitle { color: #666; margin: 0 0 1.5rem 0; }

        .info-box {
            background: #f0f4ff;
            border: 1px solid #d0d8f0;
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            line-height: 1.6;
            color: #333;
        }

        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 0.35rem; font-size: 0.9rem; }
        .form-group label .hint { font-weight: 400; color: #666; }
        .form-group input[type="text"],
        .form-group input[type="file"] {
            width: 100%;
            padding: 0.5rem 0.75rem;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .form-group input[type="file"] { padding: 0.4rem 0.5rem; }

        .btn-primary {
            padding: 0.6rem 1.5rem;
            font-size: 1rem;
            background: #0066cc;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn-primary:hover { background: #0055aa; }

        .error-box {
            background: #ffeef0;
            border: 1px solid #f5a0a0;
            border-radius: 6px;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            color: #c00;
            font-size: 0.9rem;
        }

        .notice-box {
            background: #fff8e1;
            border: 1px solid #ffe082;
            border-radius: 6px;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            color: #7a5500;
            font-size: 0.9rem;
        }

        .help-text {
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid #eee;
            font-size: 0.875rem;
            color: #555;
            line-height: 1.6;
        }
        .help-text a { color: #0066cc; text-decoration: none; }
        .help-text a:hover { text-decoration: underline; }

        @media (max-width: 540px) {
            .pdf-subnav { flex-wrap: wrap; }
        }
    </style>
    {% block pdf_extra_head %}{% endblock %}
{% endblock %}

{% block content %}
    <div class="pdf-page">
        <nav class="pdf-subnav">
            <a href="/pdf/legacy" class="{{ 'active' if active_page == 'legacy' else '' }}">Legacy Data Export</a>
            <a href="/pdf/merge" class="{{ 'active' if active_page == 'merge' else '' }}">Merge History</a>
        </nav>
        {% block pdf_content %}{% endblock %}
    </div>
{% endblock %}
